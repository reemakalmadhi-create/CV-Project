# Secret used to sign the login cookie. REQUIRED in production (any long random string).
SESSION_SECRET=change-me-to-a-long-random-string

# Where accounts/cart/orders are stored (JSON files). Defaults: ./.data locally, /tmp/fitted-data on Vercel.
# FITTED_DATA_DIR=

# URL of the Python try-on service (tryon-service/). Leave empty -> "IDM-VTON integration pending".
# TRYON_API_URL=http://localhost:8000
